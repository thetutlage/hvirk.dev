<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} | {{ site.author }}</title>
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% set ogImage = site.url + "/og/" + page.fileSlug + ".png" %}
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
<meta property="og:type" content="article">
<meta property="og:site_name" content="{{ site.author }}">
<meta property="og:title" content="{{ title }}">
{% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ ogImage }}">
<link rel="icon" href="/assets/virk.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>

<aside class="side">
  <a class="author" href="/">
    <img class="avatar" src="/assets/virk.jpg" alt="" width="72" height="72">
    <span class="name">{{ site.author }}</span>
  </a>
  <p class="bio">Principal Markdown Engineer. Building <a href="https://x.com/adonisframework">@adonisframework</a></p>
  <nav>
    <a href="https://github.com/thetutlage">GitHub</a>
  </nav>
</aside>

<main>
  <article>
    <header class="post">
      {% if series %}<p class="series">{{ series }}, part {{ part }}</p>{% endif %}
      <h1>{{ title }}</h1>
      <p class="date"><time datetime="{{ page.date.toISOString() }}">{{ page.date | readableDate }}</time></p>
    </header>
    <div class="prose">
{{ content | safe }}
    </div>
  </article>

  <section class="comments" aria-labelledby="comments-title">
    <h2 id="comments-title">Comments</h2>
    <script src="https://giscus.app/client.js"
      data-repo="thetutlage/hvirk.dev"
      data-repo-id="R_kgDOVTMbWw"
      data-category="Announcements"
      data-category-id="DIC_kwDOVTMbW84DJUX5"
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="light"
      data-lang="en"
      data-loading="lazy"
      crossorigin="anonymous"
      async>
    </script>
  </section>
</main>

</body>
</html>
